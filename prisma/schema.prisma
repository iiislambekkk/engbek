generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}


// ============================================================
// BETTER AUTH USER
// ============================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?

  createdAt DateTime
  updatedAt DateTime

  // Better Auth
  sessions Session[]
  accounts Account[]

  // Engbek
  settings   UserSettings?
  vocabulary VocabularyItem[]
  tags       Tag[]
  chats      Chat[]
}


// ============================================================
// BETTER AUTH SESSION
// ============================================================

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique

  createdAt DateTime
  updatedAt DateTime

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


// ============================================================
// BETTER AUTH ACCOUNT
// ============================================================

model Account {
  id                    String    @id
  accountId             String
  providerId            String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  scope     String?
  password  String?
  createdAt DateTime
  updatedAt DateTime

  @@index([userId])
}


// ============================================================
// BETTER AUTH VERIFICATION
// ============================================================

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
}


// ============================================================
// USER SETTINGS
// ============================================================

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  autoAddVocabulary Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ============================================================
// AI CHAT
// ============================================================

model Chat {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id         String   @id @default(cuid())
  externalId String
  chatId     String
  role       String
  message    Json
  position   Int
  createdAt  DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, externalId])
  @@unique([chatId, position])
  @@index([chatId, createdAt])
}


// ============================================================
// VOCABULARY ITEM
// ============================================================

model VocabularyItem {
  id     String @id @default(cuid())
  userId String

  term           String
  normalizedTerm  String

  type VocabularyType

  phonetic      String?
  pronunciation String?

  familiarity Familiarity @default(NEW)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  meanings Meaning[]
  sources  VocabularySource[]
  tags     VocabularyItemTag[]

  @@unique([userId, normalizedTerm, type])

  @@index([userId])
  @@index([userId, type])
  @@index([userId, familiarity])
  @@index([userId, normalizedTerm])
}


// ============================================================
// MEANING
// ============================================================

model Meaning {
  id           String @id @default(cuid())
  vocabularyId String

  definition   String
  translation  String?
  partOfSpeech PartOfSpeech?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vocabulary VocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  examples Example[]

  @@index([vocabularyId])
}


// ============================================================
// EXAMPLE
// ============================================================

model Example {
  id        String @id @default(cuid())
  meaningId String

  text String

  source ExampleSource @default(AI_GENERATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meaning Meaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  @@index([meaningId])
}


// ============================================================
// VOCABULARY SOURCE
// ============================================================

model VocabularySource {
  id           String @id @default(cuid())
  vocabularyId String

  reason VocabularyAddReason

  sourceId String?

  createdAt DateTime @default(now())

  vocabulary VocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
}


// ============================================================
// TAG
// ============================================================

model Tag {
  id     String @id @default(cuid())
  userId String

  name String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  vocabularyItems VocabularyItemTag[]

  @@unique([userId, name])
}


// ============================================================
// VOCABULARY ↔ TAG
// ============================================================

model VocabularyItemTag {
  vocabularyId String
  tagId        String

  vocabulary VocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([vocabularyId, tagId])
  @@index([tagId])
}


// ============================================================
// ENUMS
// ============================================================

enum VocabularyType {
  WORD
  PHRASE
  PHRASAL_VERB
  COLLOCATION
  IDIOM
}

enum Familiarity {
  NEW
  LEARNING
  FAMILIAR
  MASTERED
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  OTHER
}

enum ExampleSource {
  AI_GENERATED
  AI_EXTRACTED
  USER_PROVIDED
}

enum VocabularyAddReason {
  USER_REQUEST
  AI_SUGGESTION
  AI_AUTO_ADD
  MANUAL
}